# Copia este archivo a .env y ajusta valores. .env NUNCA se commitea.

ENV=local                # local | test | production
LOG_LEVEL=INFO
LOG_JSON=false           # true en producción

# Postgres. En Neon usa la URL DIRECTA (host SIN "-pooler").
# El pooler de Neon (PgBouncer en modo transaction) rompe el caché de prepared
# statements de asyncpg y las migraciones de Alembic; config.py la rechaza.
# Se acepta la URL tal cual la copia Neon (postgresql://...?sslmode=require&channel_binding=require).
DATABASE_URL=postgresql://cucharon:cucharon@localhost:5432/cucharon
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Genera cada una con: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Firma los access tokens.
JWT_SECRET=change-me
# Deriva el refresh token nuevo al rotar (ADR 0002). DEBE ser distinta de JWT_SECRET.
# Cambiarla solo deja sin periodo de gracia los refresh rotados en los últimos segundos.
REFRESH_DERIVATION_KEY=change-me-too
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Ventana para reentregar el reemplazo de un refresh recién rotado (ADR 0002).
REFRESH_TOKEN_GRACE_SECONDS=30

# Máximo de hashes argon2 en paralelo (~64 MiB c/u). Render free: 512 MiB de RAM.
PASSWORD_HASH_CONCURRENCY=2

RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_IP=20/minute
RATE_LIMIT_LOGIN_EMAIL=5/minute;20/hour

# Providers (sin implementación real todavía en Fase 0)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
FOOD_DATA_PROVIDER=

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_LOCAL_BASE_URL=http://localhost:8000/_dev/storage
STORAGE_LOCAL_SECRET=change-me

# Smoke tests (tests/smoke)
SMOKE_BASE_URL=
SMOKE_USER_EMAIL=
SMOKE_USER_PASSWORD=
